{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/policy-testing.schema.json",
  "title": "Forge Testing Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "testing"],
  "properties": {
    "schema": {"const": "forge/policy/testing@1"},
    "testing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approach", "behavioral_changes", "cycle", "red", "green", "refactor", "bugfix", "post_hoc_tests", "exceptions", "test_level", "verification"],
      "properties": {
        "approach": {"const": "tdd_first"},
        "behavioral_changes": {"type": "object", "additionalProperties": false, "required": ["tdd_required_when_reasonably_testable"], "properties": {"tdd_required_when_reasonably_testable": {"const": true}}},
        "cycle": {"type": "object", "additionalProperties": false, "required": ["required"], "properties": {"required": {"const": ["red", "green", "refactor"]}}},
        "red": {"type": "object", "additionalProperties": false, "required": ["test_before_production_implementation", "execution_required", "expected_failure_required", "invalid_failure_reasons"], "properties": {"test_before_production_implementation": {"const": true}, "execution_required": {"const": true}, "expected_failure_required": {"const": true}, "invalid_failure_reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
        "green": {"type": "object", "additionalProperties": false, "required": ["relevant_tests_must_pass", "prefer_minimum_implementation"], "properties": {"relevant_tests_must_pass": {"const": true}, "prefer_minimum_implementation": {"const": true}}},
        "refactor": {"type": "object", "additionalProperties": false, "required": ["allowed_after_green", "relevant_tests_must_remain_green", "new_behavior_requires_new_tdd_cycle"], "properties": {"allowed_after_green": {"const": true}, "relevant_tests_must_remain_green": {"const": true}, "new_behavior_requires_new_tdd_cycle": {"const": true}}},
        "bugfix": {"type": "object", "additionalProperties": false, "required": ["regression_test"], "properties": {"regression_test": {"type": "object", "additionalProperties": false, "required": ["required_when_reasonably_automatable", "must_reproduce_bug_before_fix"], "properties": {"required_when_reasonably_automatable": {"const": true}, "must_reproduce_bug_before_fix": {"const": true}}}}},
        "post_hoc_tests": {"type": "object", "additionalProperties": false, "required": ["allowed", "count_as_tdd_evidence"], "properties": {"allowed": {"const": true}, "count_as_tdd_evidence": {"const": false}}},
        "exceptions": {"type": "object", "additionalProperties": false, "required": ["allowed", "reason_required", "verification_still_required", "review_still_required"], "properties": {"allowed": {"const": true}, "reason_required": {"const": true}, "verification_still_required": {"const": true}, "review_still_required": {"const": true}}},
        "test_level": {"type": "object", "additionalProperties": false, "required": ["choose_by_behavior", "allowed"], "properties": {"choose_by_behavior": {"const": true}, "allowed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}},
        "verification": {"type": "object", "additionalProperties": false, "required": ["required", "passing_tests_alone_are_sufficient"], "properties": {"required": {"const": true}, "passing_tests_alone_are_sufficient": {"const": false}}}
      }
    }
  }
}
