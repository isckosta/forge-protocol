{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/flow.schema.json",
  "title": "Forge Canonical Flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "flow", "stages", "gates", "review"],
  "properties": {
    "schema": {"const": "forge/flow@1"},
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": {"enum": ["fast", "standard", "full"]},
        "name": {"enum": ["FAST", "STANDARD", "FULL"]},
        "description": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"id": {"const": "fast"}}}, "then": {"properties": {"name": {"const": "FAST"}}}},
        {"if": {"properties": {"id": {"const": "standard"}}}, "then": {"properties": {"name": {"const": "STANDARD"}}}},
        {"if": {"properties": {"id": {"const": "full"}}}, "then": {"properties": {"name": {"const": "FULL"}}}}
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intended_for", "disqualifiers"],
      "properties": {
        "intended_for": {"type": "array", "items": {"type": "string"}},
        "disqualifiers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"enum": ["intent", "inspection", "discovery", "specification", "specification_review", "architecture", "test_design", "test_strategy", "plan", "tasks", "tdd_implementation", "verification", "strict_review", "documentation_impact", "documentation", "knowledge_capture", "completion"]},
          "required": {"type": "boolean"},
          "required_when": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "minLength": 1},
          "cycle": {"const": ["red", "green", "refactor"]}
        },
        "anyOf": [{"required": ["required"]}, {"required": ["required_when"]}]
      },
      "allOf": [
        {"contains": {"properties": {"id": {"const": "intent"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "tdd_implementation"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "verification"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "strict_review"}}, "required": ["id"]}},
        {"contains": {"properties": {"id": {"const": "completion"}}, "required": ["id"]}}
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before_behavioral_implementation", "before_completion"],
      "properties": {
        "before_architecture": {"$ref": "#/$defs/gate"},
        "before_implementation": {"$ref": "#/$defs/gate"},
        "before_behavioral_implementation": {
          "allOf": [
            {"$ref": "#/$defs/gate"},
            {"required": ["checks"], "properties": {"checks": {"allOf": [
              {"contains": {"const": "test_exists"}},
              {"contains": {"const": "red_executed"}},
              {"contains": {"const": "red_failed_for_expected_reason"}}
            ]}}}
          ]
        },
        "before_completion": {
          "allOf": [
            {"$ref": "#/$defs/gate"},
            {"required": ["require"], "properties": {"require": {"allOf": [
              {"contains": {"const": "verification_passed"}},
              {"contains": {"const": "review_passed"}},
              {"contains": {"const": "blocking_review_threads_resolved"}},
              {"contains": {"const": "documentation_impact_evaluated"}},
              {"contains": {"const": "tdd_compliant_or_explicitly_excepted"}}
            ]}}}
          ]
        }
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "target": {"enum": ["standard", "full"]},
        "automatic_downgrade": {"const": false}
      }
    },
    "downgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic"],
      "properties": {"automatic": {"const": false}}
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "strict", "adversarial"],
      "properties": {
        "required": {"const": true},
        "strict": {"const": true},
        "adversarial": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"flow": {"properties": {"id": {"const": "fast"}}, "required": ["id"]}}},
      "then": {"properties": {"stages": {"minItems": 8, "maxItems": 8, "prefixItems": [
        {"properties": {"id": {"const": "intent"}}, "required": ["id"]},
        {"properties": {"id": {"const": "inspection"}}, "required": ["id"]},
        {"properties": {"id": {"const": "test_design"}}, "required": ["id"]},
        {"properties": {"id": {"const": "tdd_implementation"}}, "required": ["id"]},
        {"properties": {"id": {"const": "verification"}}, "required": ["id"]},
        {"properties": {"id": {"const": "strict_review"}}, "required": ["id"]},
        {"properties": {"id": {"const": "documentation_impact"}}, "required": ["id"]},
        {"properties": {"id": {"const": "completion"}}, "required": ["id"]}
      ]}}}
    },
    {
      "if": {"properties": {"flow": {"properties": {"id": {"const": "standard"}}, "required": ["id"]}}},
      "then": {"properties": {"stages": {"minItems": 10, "maxItems": 10, "prefixItems": [
        {"properties": {"id": {"const": "intent"}}, "required": ["id"]},
        {"properties": {"id": {"const": "discovery"}}, "required": ["id"]},
        {"properties": {"id": {"const": "specification"}}, "required": ["id"]},
        {"properties": {"id": {"const": "test_design"}}, "required": ["id"]},
        {"properties": {"id": {"const": "plan"}}, "required": ["id"]},
        {"properties": {"id": {"const": "tdd_implementation"}}, "required": ["id"]},
        {"properties": {"id": {"const": "verification"}}, "required": ["id"]},
        {"properties": {"id": {"const": "strict_review"}}, "required": ["id"]},
        {"properties": {"id": {"const": "documentation"}}, "required": ["id"]},
        {"properties": {"id": {"const": "completion"}}, "required": ["id"]}
      ]}}}
    },
    {
      "if": {"properties": {"flow": {"properties": {"id": {"const": "full"}}, "required": ["id"]}}},
      "then": {"properties": {"stages": {"minItems": 14, "maxItems": 14, "prefixItems": [
        {"properties": {"id": {"const": "intent"}}, "required": ["id"]},
        {"properties": {"id": {"const": "discovery"}}, "required": ["id"]},
        {"properties": {"id": {"const": "specification"}}, "required": ["id"]},
        {"properties": {"id": {"const": "specification_review"}}, "required": ["id"]},
        {"properties": {"id": {"const": "architecture"}}, "required": ["id"]},
        {"properties": {"id": {"const": "test_strategy"}}, "required": ["id"]},
        {"properties": {"id": {"const": "plan"}}, "required": ["id"]},
        {"properties": {"id": {"const": "tasks"}}, "required": ["id"]},
        {"properties": {"id": {"const": "tdd_implementation"}}, "required": ["id"]},
        {"properties": {"id": {"const": "verification"}}, "required": ["id"]},
        {"properties": {"id": {"const": "strict_review"}}, "required": ["id"]},
        {"properties": {"id": {"const": "documentation"}}, "required": ["id"]},
        {"properties": {"id": {"const": "knowledge_capture"}}, "required": ["id"]},
        {"properties": {"id": {"const": "completion"}}, "required": ["id"]}
      ]}}}
    }
  ],
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "require": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "require_when": {"type": "string", "minLength": 1},
        "checks": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true}
      },
      "anyOf": [{"required": ["require"]}, {"required": ["checks"]}]
    }
  }
}
