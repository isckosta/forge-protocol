{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/flow.schema.json",
  "title": "Forge Canonical Flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "flow", "stages", "gates", "review"],
  "properties": {
    "schema": {"const": "forge/flow@1"},
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description"],
      "properties": {
        "id": {"enum": ["fast", "standard", "full"]},
        "name": {"enum": ["FAST", "STANDARD", "FULL"]},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intended_for", "disqualifiers"],
      "properties": {
        "intended_for": {"type": "array", "items": {"type": "string"}},
        "disqualifiers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "required_when": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "minLength": 1},
          "cycle": {
            "type": "array",
            "items": {"enum": ["red", "green", "refactor"]},
            "uniqueItems": true
          }
        },
        "anyOf": [{"required": ["required"]}, {"required": ["required_when"]}]
      }
    },
    "gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "require": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "require_when": {"type": "string", "minLength": 1},
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          }
        },
        "anyOf": [{"required": ["require"]}, {"required": ["checks"]}]
      }
    },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "target": {"enum": ["standard", "full"]},
        "automatic_downgrade": {"const": false}
      }
    },
    "downgrade": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic"],
      "properties": {"automatic": {"const": false}}
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "strict", "adversarial"],
      "properties": {
        "required": {"const": true},
        "strict": {"const": true},
        "adversarial": {"const": true}
      }
    }
  }
}
