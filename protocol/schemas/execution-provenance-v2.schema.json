{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/execution-provenance-v2.schema.json",
  "title": "Forge Execution Provenance Ledger (v2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "change", "records"],
  "properties": {
    "schema": {"const": "forge/execution-provenance@2"},
    "change": {"type": "string", "pattern": "^CHG-[0-9]{4,}$"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "execution", "recorded_at", "revision", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["implementation", "resolution", "review", "delegated_task"]},
          "execution": {"type": "object", "additionalProperties": false, "required": ["id", "context_id"], "properties": {"id": {"type": "string", "minLength": 1}, "context_id": {"type": "string", "minLength": 1}, "delegated_by": {"type": "string", "minLength": 1}}},
          "recorded_at": {"type": "string", "format": "date-time"},
          "scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "baseline": {"type": "object", "additionalProperties": false, "required": ["head", "dirty"], "properties": {"head": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}, "dirty": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "hash"], "properties": {"path": {"type": "string", "minLength": 1}, "hash": {"type": "string", "minLength": 1}}}}}},
          "revision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "immutable_ref": {"type": "object", "additionalProperties": false, "required": ["type", "value"], "properties": {"type": {"enum": ["git_commit", "content_digest", "vcs_revision"]}, "value": {"type": "string", "minLength": 1}}},
              "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
              "description": {"type": "string", "minLength": 1}
            },
            "anyOf": [{"required": ["immutable_ref"]}, {"required": ["commit"]}]
          },
          "source": {"type": "object", "additionalProperties": false, "required": ["assurance", "observed_by"], "properties": {"assurance": {"enum": ["claimed", "recorded", "verified"]}, "observed_by": {"enum": ["self", "operator", "adapter", "harness"]}, "harness": {"type": "string", "minLength": 1}, "reference": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}}}
        },
        "allOf": [
          {"if": {"properties": {"role": {"const": "delegated_task"}}, "required": ["role"]}, "then": {"required": ["scope", "baseline"], "properties": {"execution": {"required": ["id", "context_id", "delegated_by"]}}}}
        ]
      }
    }
  }
}
