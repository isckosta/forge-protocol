{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/policy-review-v2.schema.json",
  "title": "Forge Review Policy (Protocol 2)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "review"],
  "properties": {
    "schema": {"const": "forge/policy/review@2"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "strict", "adversarial", "objective", "severities", "blocking", "dimensions", "tdd_review", "evidence", "reviewer_resolver_separation", "diff_only_review", "passing_tests_are_sufficient", "re_review"],
      "properties": {
        "required": {"const": true},
        "strict": {"const": true},
        "adversarial": {"const": true},
        "objective": {"type": "string", "minLength": 1},
        "severities": {"const": ["blocker", "major", "minor", "observation"]},
        "blocking": {"type": "array", "contains": {"const": "blocker"}, "items": {"enum": ["blocker", "major", "minor", "observation"]}, "uniqueItems": true},
        "dimensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tdd_review": {"type": "object"},
        "evidence": {"type": "object"},
        "reviewer_resolver_separation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["independence", "same_execution_forbidden", "same_context_forbidden", "role_switch_is_independence", "self_review_satisfies_strict_review", "provenance_required_for_review_passed", "minimum_assurance", "revision_binding_required", "same_harness_model_or_provider_allowed", "human_preferred_for_full"],
          "properties": {
            "independence": {"type": "object", "additionalProperties": false, "required": ["fast", "standard", "full"], "properties": {"fast": {"const": "execution_context"}, "standard": {"const": "execution_context"}, "full": {"const": "execution_context"}}},
            "same_execution_forbidden": {"const": true},
            "same_context_forbidden": {"const": true},
            "role_switch_is_independence": {"const": false},
            "self_review_satisfies_strict_review": {"const": false},
            "provenance_required_for_review_passed": {"const": true},
            "minimum_assurance": {"const": "recorded"},
            "revision_binding_required": {"const": true},
            "same_harness_model_or_provider_allowed": {"const": true},
            "human_preferred_for_full": {"type": "boolean"}
          }
        },
        "diff_only_review": {"type": "object", "additionalProperties": false, "required": ["allowed"], "properties": {"allowed": {"const": false}}},
        "passing_tests_are_sufficient": {"type": "object", "additionalProperties": false, "required": ["value"], "properties": {"value": {"const": false}}},
        "re_review": {"type": "object", "additionalProperties": false, "required": ["required_after_blocking_resolution", "independent_from_resolution_execution", "target_resolution_revision"], "properties": {"required_after_blocking_resolution": {"const": true}, "independent_from_resolution_execution": {"const": true}, "target_resolution_revision": {"const": true}}}
      }
    }
  }
}
