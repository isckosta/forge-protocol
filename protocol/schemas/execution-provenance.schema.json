{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/execution-provenance.schema.json",
  "title": "Forge Execution Provenance Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "change", "records"],
  "properties": {
    "schema": {"const": "forge/execution-provenance@1"},
    "change": {"type": "string", "pattern": "^CHG-[0-9]{4,}$"},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "execution", "recorded_at", "revision", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["implementation", "resolution", "review"]},
          "execution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "context_id"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "context_id": {"type": "string", "minLength": 1}
            }
          },
          "recorded_at": {"type": "string", "format": "date-time"},
          "revision": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "immutable_ref"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "immutable_ref": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "value"],
                "properties": {
                  "type": {"enum": ["git_commit", "content_digest", "vcs_revision"]},
                  "value": {"type": "string", "minLength": 1}
                }
              },
              "commit": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
              "description": {"type": "string", "minLength": 1}
            }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assurance", "observed_by"],
            "properties": {
              "assurance": {"enum": ["claimed", "recorded", "verified"]},
              "observed_by": {"enum": ["self", "operator", "adapter", "harness"]},
              "harness": {"type": "string", "minLength": 1},
              "reference": {"type": "string", "minLength": 1},
              "statement": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
