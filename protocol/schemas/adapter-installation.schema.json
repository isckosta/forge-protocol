{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forge.dev/schemas/adapter-installation.schema.json",
  "title": "Forge Adapter Installation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "adapter",
    "protocol",
    "generated_artifacts",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "forge/adapter-installation@1"
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "harness"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "harness": {"type": "string", "minLength": 1}
      }
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max_exclusive"],
      "properties": {
        "min": {"type": "integer", "minimum": 1},
        "max_exclusive": {"type": "integer", "minimum": 2}
      }
    },
    "generated_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
